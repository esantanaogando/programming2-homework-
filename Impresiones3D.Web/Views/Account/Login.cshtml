@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión"; Layout = "_Layout";
}

<div class="login-wrap">
    <div class="login-card">
        <div style="text-align:center; margin-bottom:28px;">
            <div style="width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,#7C3AED,#4F46E5);display:inline-flex;align-items:center;justify-content:center;font-size:26px;color:#fff;margin-bottom:14px;">⬡</div>
            <h1 style="font-size:20px;font-weight:600;color:#111827;margin:0;">3DPrintFlow</h1>
            <p style="font-size:13px;color:#6B7280;margin:4px 0 0;">Ingresa tus credenciales para continuar</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="font-size:13px;"></div>

        <form asp-action="Login" method="post">
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Correo electrónico</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="admin@3dprintflow.com" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger" style="font-size:12px;"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Password" class="form-label">Contraseña</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger" style="font-size:12px;"></span>
            </div>
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label" style="font-size:13px;color:#374151;">Recordarme</label>
                </div>
            </div>
            <button type="submit" class="btn btn-primary w-100" style="padding:10px;border-radius:8px;font-weight:500;">
                Iniciar sesión
            </button>
        </form>

        <p style="text-align:center;font-size:12px;color:#9CA3AF;margin-top:24px;">
            Admin: admin@3dprintflow.com · Admin123!<br />
            Operador: operador@3dprintflow.com · Operador123!
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
