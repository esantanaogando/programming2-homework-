@model Impresiones3D.Web.Models.MaterialViewModel

<h2>Nuevo Material</h2>
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" class="form-control" required />
    </div>
    <div class="form-group">
        <label asp-for="Color"></label>
        <input asp-for="Color" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="PrecioPorGramo"></label>
        <input asp-for="PrecioPorGramo" class="form-control" type="number" step="0.01" required />
    </div>
    <div class="form-group">
        <label asp-for="Stock"></label>
        <input asp-for="Stock" class="form-control" type="number" step="0.01" required />
    </div>
    <div class="form-group">
        <label asp-for="UnidadMedida"></label>
        <input asp-for="UnidadMedida" class="form-control" value="gramos" />
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}