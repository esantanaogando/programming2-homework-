@model IEnumerable<Impresiones3D.Web.Models.MaterialViewModel>

<h2>Materiales</h2>
<p><a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nuevo Material</a></p>

<table class="table table-striped">
    <thead>
        <tr><th>ID</th><th>Nombre</th><th>Color</th><th>Precio x Gramo</th><th>Stock</th><th>Unidad</th><th>Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Nombre</td>
                <td>@item.Color</td>
                <td>@item.PrecioPorGramo.ToString("C")</td>
                <td>@item.Stock</td>
                <td>@item.UnidadMedida</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm" title="Detalles"><i class="bi bi-info-circle"></i></a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm" title="Editar"><i class="bi bi-pencil"></i></a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" title="Eliminar"><i class="bi bi-trash"></i></a>
                </td>
            </tr>
        }
    </tbody>
</table>