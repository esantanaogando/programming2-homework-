@model Impresiones3D.Web.Models.OrdenViewModel

<h2>Nueva Orden de Impresión</h2>
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="ClienteId"></label>
        <select asp-for="ClienteId" asp-items="ViewBag.Clientes" class="form-control" required>
            <option value="">-- Seleccione cliente --</option>
        </select>
        <span asp-validation-for="ClienteId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="MaterialId"></label>
        <select asp-for="MaterialId" asp-items="ViewBag.Materiales" class="form-control" required>
            <option value="">-- Seleccione material --</option>
        </select>
    </div>
    <div class="form-group">
        <label asp-for="DescripcionModelo"></label>
        <input asp-for="DescripcionModelo" class="form-control" required />
    </div>
    <div class="form-group">
        <label asp-for="CantidadPiezas"></label>
        <input asp-for="CantidadPiezas" class="form-control" value="1" />
    </div>
    <div class="form-group">
        <label asp-for="AlturaCapa"></label>
        <input asp-for="AlturaCapa" class="form-control" value="0.2" step="0.01" />
    </div>
    <div class="form-group">
        <label asp-for="Relleno"></label>
        <input asp-for="Relleno" class="form-control" value="20" />
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}