@model IEnumerable<Impresiones3D.Web.Models.OrdenViewModel>

<h2>Órdenes de Impresión</h2>
<p><a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nueva Orden</a></p>

<table class="table table-striped">
    <thead>
    <td>
    <th>ID</th>
    <th>Cliente</th>
    <th>Material</th>
    <th>Piezas</th>
    <th>Estado</th>
    <th>Total (estimado)</th>
    <th>Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.ClienteNombre</td>
                <td>@item.MaterialNombre</td>
                <td>@item.CantidadPiezas</td>
                <td><span class="badge-estado badge-@item.Estado">@item.EstadoTexto</span></td>
                <td>@item.CostoEstimado.ToString("C")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm" title="Detalles"><i class="bi bi-info-circle"></i></a>
                    <a asp-action="CambiarEstado" asp-route-id="@item.Id" class="btn btn-warning btn-sm" title="Cambiar Estado"><i class="bi bi-arrow-repeat"></i></a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm" title="Editar"><i class="bi bi-pencil"></i></a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" title="Eliminar"><i class="bi bi-trash"></i></a>
                </td>
            </tr>
        }
    </tbody>
</table>