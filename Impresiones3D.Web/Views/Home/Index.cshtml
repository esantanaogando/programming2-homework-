@model Impresiones3D.Web.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Description"] = "Panel de control de 3DPrintFlow";
}

<!-- Tarjetas de estadísticas -->
<div class="row g-4 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted text-uppercase small">Clientes</span>
                    <h2 class="mb-0 mt-1 fw-bold">@Model.TotalClientes</h2>
                </div>
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle">
                    <i class="bi bi-people fs-4 text-primary"></i>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="Clientes" asp-action="Index" class="text-decoration-none">Ver todos <i class="bi bi-arrow-right-short"></i></a>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted text-uppercase small">Materiales</span>
                    <h2 class="mb-0 mt-1 fw-bold">@Model.TotalMateriales</h2>
                </div>
                <div class="bg-success bg-opacity-10 p-3 rounded-circle">
                    <i class="bi bi-box-seam fs-4 text-success"></i>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="Materiales" asp-action="Index" class="text-decoration-none">Ver todos <i class="bi bi-arrow-right-short"></i></a>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted text-uppercase small">Impresoras</span>
                    <h2 class="mb-0 mt-1 fw-bold">@Model.TotalImpresoras</h2>
                </div>
                <div class="bg-warning bg-opacity-10 p-3 rounded-circle">
                    <i class="bi bi-printer fs-4 text-warning"></i>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="Impresoras" asp-action="Index" class="text-decoration-none">Ver todos <i class="bi bi-arrow-right-short"></i></a>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted text-uppercase small">Órdenes</span>
                    <h2 class="mb-0 mt-1 fw-bold">@Model.TotalOrdenes</h2>
                </div>
                <div class="bg-info bg-opacity-10 p-3 rounded-circle">
                    <i class="bi bi-file-earmark-text fs-4 text-info"></i>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="Ordenes" asp-action="Index" class="text-decoration-none">Ver todos <i class="bi bi-arrow-right-short"></i></a>
            </div>
        </div>
    </div>
</div>

<!-- Gráfico de órdenes por estado y últimas órdenes -->
<div class="row g-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 pt-4">
                <h5 class="card-title mb-0">Órdenes por estado</h5>
            </div>
            <div class="card-body">
                <!-- Pendientes -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small">Pendientes</span>
                        <span class="small fw-semibold">@Model.OrdenesPendientes</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-secondary" style="width: @(Model.TotalOrdenes > 0 ? (Model.OrdenesPendientes * 100 / Model.TotalOrdenes) : 0)%"></div>
                    </div>
                </div>
                <!-- En producción -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small">En producción</span>
                        <span class="small fw-semibold">@Model.OrdenesEnProduccion</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-primary" style="width: @(Model.TotalOrdenes > 0 ? (Model.OrdenesEnProduccion * 100 / Model.TotalOrdenes) : 0)%"></div>
                    </div>
                </div>
                <!-- Completadas -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small">Completadas</span>
                        <span class="small fw-semibold">@Model.OrdenesCompletadas</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-success" style="width: @(Model.TotalOrdenes > 0 ? (Model.OrdenesCompletadas * 100 / Model.TotalOrdenes) : 0)%"></div>
                    </div>
                </div>
                <!-- Entregadas -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small">Entregadas</span>
                        <span class="small fw-semibold">@Model.OrdenesEntregadas</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-info" style="width: @(Model.TotalOrdenes > 0 ? (Model.OrdenesEntregadas * 100 / Model.TotalOrdenes) : 0)%"></div>
                    </div>
                </div>
                <!-- Canceladas -->
                <div class="mb-2">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small">Canceladas</span>
                        <span class="small fw-semibold">@Model.OrdenesCanceladas</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-danger" style="width: @(Model.TotalOrdenes > 0 ? (Model.OrdenesCanceladas * 100 / Model.TotalOrdenes) : 0)%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 pt-4">
                <h5 class="card-title mb-0">Últimas órdenes</h5>
            </div>
            <div class="card-body p-0">
                @if (Model.OrdenesRecientes != null && Model.OrdenesRecientes.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var orden in Model.OrdenesRecientes)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="fw-semibold">#@orden.Id</span> – @orden.ClienteNombre
                                    <div class="small text-muted">@orden.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                                <span class="badge-estado badge-@orden.Estado">@orden.EstadoTexto</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mt-2">No hay órdenes registradas</p>
                    </div>
                }
            </div>
            <div class="card-footer bg-transparent border-0 pb-4">
                <a asp-controller="Ordenes" asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-lg"></i> Nueva orden
                </a>
            </div>
        </div>
    </div>
</div>