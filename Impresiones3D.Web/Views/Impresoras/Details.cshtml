@model Impresiones3D.Web.Models.ImpresoraViewModel

<h2>Detalles de Impresora</h2>
<dl class="row">
    <dt class="col-sm-2">ID</dt>
    <dd class="col-sm-10">@Model.Id</dd>
    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.Nombre</dd>
    <dt class="col-sm-2">Modelo</dt>
    <dd class="col-sm-10">@Model.Modelo</dd>
    <dt class="col-sm-2">Tecnología</dt>
    <dd class="col-sm-10">@Model.Tecnologia</dd>
    <dt class="col-sm-2">Estado</dt>
    <dd class="col-sm-10">@Model.Estado</dd>
    <dt class="col-sm-2">Velocidad Max.</dt>
    <dd class="col-sm-10">@Model.VelocidadMaxima mm/s</dd>
    <dt class="col-sm-2">Volumen (X,Y,Z)</dt>
    <dd class="col-sm-10">@Model.VolumenX x @Model.VolumenY x @Model.VolumenZ mm</dd>
</dl>
<a asp-action="Index" class="btn btn-secondary">Volver</a>